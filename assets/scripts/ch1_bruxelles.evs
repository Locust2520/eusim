# ---------------------------------------------------------------- Chapter 1 — Bruxelles
script studio_onload
  if flag INTRO_DONE goto done
  setflag INTRO_DONE
  call cine_prologue
  say - "Premier jour de stage au Parlement européen ! Le professeur Schuman t'attend dans le hall du Parlement."
:done
end

script studio_pc
  say - "Ton ordinateur affiche 437 courriels non lus. Ils ont tous pour objet « Réunion de coordination sur les réunions »."
end

script studio_jukebox
  if !flag BADGE_1 goto panne
  special jukebox
  goto fin
:panne
  say - "Un vieux juke-box, débranché. Une étiquette : « À rebrancher après votre premier badge. — Le service technique »"
:fin
end

script bxl_sign_parc
  say - "Parc Léopold. Attention : les piles de dossiers abritent des Euromons sauvages. Ne pas nourrir les Amendons."
end

script bxl_sign_berlaymont
  say - "Berlaymont — Commission européenne. Accès réservé. 13ᵉ étage : bureau (et chambre) de la Présidente."
end

script bxl_statue
  say - "« L'Europe ne se fera pas d'un coup, ni dans une construction d'ensemble : elle se fera par des réalisations concrètes. » — Robert Schuman, 9 mai 1950."
end

script bxl_lobbyist
  say "Lobbyiste" "Bonjour ! Je ne fais pas de lobbying. Je fais du « partage d'expertise ». Un petit four ? Il est au saumon. Norvégien."
end

script bxl_tourist
  say "Touriste" "Excuse me, où est le Manneken-Pis ? On m'a dit qu'il était plus grand… On m'a beaucoup menti sur ce voyage."
end

script bxl_kid
  say "Enfant" "Quand je serai grand, je serai interprète ! En 24 langues. Ou alors pompier, c'est plus calme."
end

script bxl_journaliste
  say "Journaliste" "Je couvre l'Union européenne depuis vingt ans. Mon titre préféré : « Bruxelles dit non ». Il marche à chaque fois."
end

script bxl_hugo
  say "Hugo" "Tu as gagné… Paraît que la directive sur l'heure d'été est bloquée au Conseil depuis 2019. Bon courage, hein."
end

script bxl_agent_route
  say "Agent de sécurité" "La route des Ardennes ? Pas sans Euromon ! Les dossiers sauvages sont agressifs en cette saison budgétaire."
end

script bxl_exit_block
  say "Agent de sécurité" "Halte ! Personne ne quitte Bruxelles sans Euromon. Allez d'abord voir le professeur Schuman, au Parlement."
  move player "L"
end

script berlaymont_locked
  say "Garde" "Le 13ᵉ étage ? Seuls ceux qui ont convaincu le Conseil européen peuvent monter. Et il faut d'abord les huit badges."
  move player "D"
end

script europa_locked
  say "Garde" "Le bâtiment Europa accueille le Conseil européen. Il vous faut les huit badges des traités pour être reçu."
  move player "D"
end

script dgcomp_locked
  if !flag BADGE_6 goto pas_pret
  say "Huissière" "La commissaire est… très occupée. On dit que la Team Lobby bloque toutes ses enquêtes. Ça se passe sous le bar de la place Lux."
  goto fin
:pas_pret
  say "Huissière" "La DG Concurrence ne reçoit que les stagiaires expérimentés. Revenez avec au moins six badges."
:fin
  move player "D"
end

script parl_agent
  if flag GOT_STARTER goto apres
  say "Agent du Parlement" "Bienvenue au Parlement européen ! Le professeur Schuman vous attend au fond du hall."
  goto fin
:apres
  say "Agent du Parlement" "L'escalier à droite mène aux étages… On dit qu'une aile est hantée. Je n'y vais jamais, moi."
:fin
end

script lab_intro
  setflag OLIVER_AT_LAB
  show L schuman happy
  say "Professeur Schuman" "Ah, {P} ! Te voilà enfin ! Ponctuel… à une heure près. Satané changement d'heure."
  show R oliver neutral
  say "Oliver" "Hi ! Je suis arrivé il y a une heure. Moi, je suis à l'heure de Londres."
  close
  hide all
  cine "Le laboratoire du professeur"
  slide s02_labo_01_oeufs zoom_in fade
  say "Professeur Schuman" "Bien. Vous allez travailler avec des Euromons. Les dossiers de ce Parlement en sont pleins."
  say "Professeur Schuman" "J'en ai trois ici, tout jeunes. Ils sont nés de grandes idées européennes. Choisis le tien, {P}."
  say "Oliver" "Ils sortent… de chemises cartonnées ?"
  say "Professeur Schuman" "À Bruxelles, tout ce qui compte commence dans une chemise cartonnée, Oliver. Même l'Europe."
  say "Professeur Schuman" "VERDEAL, né du Pacte vert. CHARBONNET, issu de la CECA de 1951. Ou ATOMINO, tout droit sorti d'Euratom."
  choice "Verdeal (type Vert)" "Charbonnet (type Industrie)" "Atomino (type Énergie)" -> STARTER
  close
  if var STARTER == 1 goto c
  if var STARTER == 2 goto a
  givemon verdeal 5
  goto suite
:c
  givemon charbonnet 5
  goto suite
:a
  givemon atomino 5
:suite
  setflag GOT_STARTER
  setflag TRAIN_BRUXELLES
  say "Professeur Schuman" "Excellent choix ! Prends-en soin. Un Euromon bien traité vaut mieux que dix traités mal ratifiés."
  slide s02_labo_02_duel zoom_in flash
  say "Oliver" "Alors je prends celui qui bat le tien. That's just smart negotiation."
  say "Professeur Schuman" "Oliver ! Ce n'est pas très… communautaire."
  say "Oliver" "Allez, {P}, un petit débat pour voir qui est le meilleur stagiaire ?"
  cine end
  if var STARTER == 1 goto bc
  if var STARTER == 2 goto ba
  battle oliver1_v nolose
  goto apres
:bc
  battle oliver1_c nolose
  goto apres
:ba
  battle oliver1_a nolose
:apres
  heal
  show L schuman happy
  show R oliver neutral
  if var RESULT == 0 goto perdu
  focus R
  say "Oliver" "What ?! J'ai perdu contre un stagiaire continental ?! C'était… un galop d'essai."
  goto suite2
:perdu
  focus R
  say "Oliver" "Ha ! Comme prévu. Ne le prends pas mal, {P}, c'est culturel."
:suite2
  focus L
  say "Professeur Schuman" "Bravo à tous les deux. Maintenant, la mission : faire adopter la directive sur la fin du changement d'heure."
  expr L worried
  say "Professeur Schuman" "Le Parlement l'a votée en mars 2019. Depuis, elle dort au Conseil. Il vous faudra les huit badges des traités pour être pris au sérieux."
  expr L neutral
  say "Professeur Schuman" "Le premier badge vous attend au Luxembourg, chez Jean-Claude Juncker. Prenez la route des Ardennes, à l'est."
  focus R
  say "Oliver" "Le Luxembourg ? Easy. J'y serai avant toi. See you, loser… euh, collègue !"
  hide R
  move oliver_bxl "D3" nowait
  call monnet_gift
end

script monnet_gift
  if flag GOT_DEX goto fin
  setflag GOT_DEX
  show R monnet happy
  say "Jean Monnet" "Un instant, {P} ! Je suis Jean Monnet. J'ai inventé la méthode des petits pas. Voici un grand pas : l'EURODEX."
  giveitem eurodex
  say "Jean Monnet" "Il enregistre chaque Euromon que tu rencontres. Et voici de quoi les tamponner officiellement."
  giveitem tampon 5
  giveitem cafe 3
  say "Jean Monnet" "Affaiblis un Euromon sauvage, puis lance un Tampon officiel depuis le SAC. L'Europe compte sur toi !"
:fin
end

script schuman_lab
  if !flag GOT_STARTER goto debut
  show L schuman happy
  if badge 8 goto huit
  say "Professeur Schuman" "Courage, {P} ! Chaque badge est une petite pierre. Comme pour l'Europe : des réalisations concrètes."
  goto fin
:huit
  say "Professeur Schuman" "Huit badges ! Le Conseil européen t'attend au bâtiment Europa. Je suis si fier."
  goto fin
:debut
  call lab_intro
:fin
end

script monnet_lab
  show R monnet neutral
  if !flag GOT_DEX goto rien
  say "Jean Monnet" "Montre-moi ton Eurodex…"
  special dex_rating
  goto fin
:rien
  say "Jean Monnet" "Parle d'abord au professeur Schuman, jeune stagiaire."
:fin
end

script oliver_bxl
  show R oliver neutral
  say "Oliver" "Le professeur est là-bas. Fais vite, je m'ennuie."
end
