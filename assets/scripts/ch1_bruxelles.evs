# ---------------------------------------------------------------- Chapter 1 — Bruxelles
script studio_onload
  if flag INTRO_DONE goto done
  setflag INTRO_DONE
  call cine_prologue
  say - "First day of your internship at the European Parliament! Professor Schuman is waiting for you in the Parliament hall."
:done
end

script studio_pc
  say - "Your computer shows 437 unread emails. They're all titled “Coordination meeting about meetings”."
end

script studio_jukebox
  if !flag BADGE_1 goto panne
  special jukebox
  goto fin
:panne
  say - "An old jukebox, unplugged. A label: “To be plugged back in after your first badge. — Technical services”"
:fin
end

script bxl_sign_parc
  say - "Leopold Park. Warning: the piles of files are home to wild Euromons. Do not feed the Amendons."
end

script bxl_sign_berlaymont
  say - "Berlaymont — European Commission. Restricted access. 13th floor: the President's office (and bedroom)."
end

script bxl_statue
  say - "“Europe will not be made all at once, or according to a single plan. It will be built through concrete achievements.” — Robert Schuman, 9 May 1950."
end

script bxl_lobbyist
  say "Lobbyist" "Hello! I don't do lobbying. I do “expertise sharing”. A canapé? It's salmon. Norwegian."
end

script bxl_tourist
  say "Tourist" "Excuse me, where's the Manneken Pis? They told me it was bigger… They've told me a lot of lies on this trip."
end

script bxl_kid
  say "Child" "When I grow up, I'll be an interpreter! In 24 languages. Or a firefighter, it's calmer."
end

script bxl_journaliste
  say "Journalist" "I've been covering the European Union for twenty years. My favourite headline: “Brussels says no”. It works every time."
end

script bxl_hugo
  say "Hugo" "You won… Apparently the daylight saving directive has been stuck in the Council since 2019. Good luck with that."
end

script bxl_agent_route
  say "Security guard" "The Ardennes road? Not without a Euromon! Wild files are aggressive in budget season."
end

script bxl_exit_block
  say "Security guard" "Halt! Nobody leaves Brussels without a Euromon. Go and see Professor Schuman at Parliament first."
  move player "L"
end

script berlaymont_locked
  say "Guard" "The 13th floor? Only those who have convinced the European Council may go up. And you need the eight badges first."
  move player "D"
end

script europa_locked
  say "Guard" "The Europa building hosts the European Council. You need the eight treaty badges to be received."
  move player "D"
end

script dgcomp_locked
  if !flag BADGE_6 goto pas_pret
  say "Head usher" "The commissioner is… very busy. They say Team Lobby is blocking all her investigations. It's happening under the bar on Place Lux."
  goto fin
:pas_pret
  say "Head usher" "DG Competition only receives experienced interns. Come back with at least six badges."
:fin
  move player "D"
end

script parl_agent
  if flag GOT_STARTER goto apres
  say "Parliament officer" "Welcome to the European Parliament! Professor Schuman is waiting for you at the back of the hall."
  goto fin
:apres
  say "Parliament officer" "The stairs on the right lead to the upper floors… They say one wing is haunted. I never go there, myself."
:fin
end

script lab_intro
  setflag OLIVER_AT_LAB
  show L schuman happy
  say "Professor Schuman" "Ah, {P}! There you are at last! Punctual… give or take an hour. Blasted clock change."
  show R oliver neutral
  say "Oliver" "Hi! I arrived an hour ago. I'm on London time, you see."
  close
  hide all
  cine "The professor's laboratory"
  slide s02_labo_01_oeufs zoom_in fade
  say "Professor Schuman" "Right. You're going to work with Euromons. This Parliament's files are full of them."
  say "Professor Schuman" "I have three here, very young. They were born from great European ideas. Choose yours, {P}."
  say "Oliver" "They come out of… cardboard folders?"
  say "Professor Schuman" "In Brussels, everything that matters starts in a cardboard folder, Oliver. Even Europe."
  say "Professor Schuman" "GREENDEER, born of the Green Deal. COALBONNET, from the 1951 ECSC. Or ATOMINO, straight out of Euratom."
  choice "GreenDeer (Green type)" "Coalbonnet (Industry type)" "Atomino (Energy type)" -> STARTER
  close
  if var STARTER == 1 goto c
  if var STARTER == 2 goto a
  givemon verdeal 5
  goto suite
:c
  givemon charbonnet 5
  goto suite
:a
  givemon atomino 5
:suite
  setflag GOT_STARTER
  setflag TRAIN_BRUXELLES
  say "Professor Schuman" "Excellent choice! Take good care of it. One well-treated Euromon is worth ten badly ratified treaties."
  slide s02_labo_02_duel zoom_in flash
  say "Oliver" "Then I'll take the one that beats yours. That's just smart negotiation."
  say "Professor Schuman" "Oliver! That's not very… communitarian."
  say "Oliver" "Come on, {P}, a little debate to see who's the best intern?"
  cine end
  if var STARTER == 1 goto bc
  if var STARTER == 2 goto ba
  battle oliver1_v nolose
  goto apres
:bc
  battle oliver1_c nolose
  goto apres
:ba
  battle oliver1_a nolose
:apres
  heal
  show L schuman happy
  show R oliver neutral
  if var RESULT == 0 goto perdu
  focus R
  say "Oliver" "What?! I lost to a continental intern?! That was… a trial run."
  goto suite2
:perdu
  focus R
  say "Oliver" "Ha! As expected. Don't take it badly, {P}, it's cultural."
:suite2
  focus L
  say "Professor Schuman" "Well done, both of you. Now, the mission: get the directive ending the clock change adopted."
  expr L worried
  say "Professor Schuman" "Parliament voted for it in March 2019. Since then, it's been sleeping in the Council. You'll need the eight treaty badges to be taken seriously."
  expr L neutral
  say "Professor Schuman" "The first badge awaits you in Luxembourg, with Jean-Claude Juncker. Take the Ardennes road, to the east."
  focus R
  say "Oliver" "Luxembourg? Easy. I'll be there before you. See you, loser… er, colleague!"
  hide R
  move oliver_bxl "D3" nowait
  call monnet_gift
end

script monnet_gift
  if flag GOT_DEX goto fin
  setflag GOT_DEX
  show R monnet happy
  say "Jean Monnet" "One moment, {P}! I'm Jean Monnet. I invented the small-steps method. Here's a big step: the EURODEX."
  giveitem eurodex
  say "Jean Monnet" "It records every Euromon you meet. And here's what you need to stamp them officially."
  giveitem tampon 5
  giveitem cafe 3
  say "Jean Monnet" "Weaken a wild Euromon, then throw an Official Stamp from the BAG. Europe is counting on you!"
:fin
end

script schuman_lab
  if !flag GOT_STARTER goto debut
  show L schuman happy
  if badge 8 goto huit
  say "Professor Schuman" "Courage, {P}! Each badge is a small stone. Just like Europe: concrete achievements."
  goto fin
:huit
  say "Professor Schuman" "Eight badges! The European Council awaits you at the Europa building. I'm so proud."
  goto fin
:debut
  call lab_intro
:fin
end

script monnet_lab
  show R monnet neutral
  if !flag GOT_DEX goto rien
  say "Jean Monnet" "Show me your Eurodex…"
  special dex_rating
  goto fin
:rien
  say "Jean Monnet" "Talk to Professor Schuman first, young intern."
:fin
end

script oliver_bxl
  show R oliver neutral
  say "Oliver" "The professor's over there. Hurry up, I'm bored."
end
