# ---------------------------------------------------------------- shared services
script cantine_heal
  show R cantiniere neutral
  say "Canteen lady" "Welcome to the canteen! A coffee, a sandwich, and your Euromons are good as new… well, as good as 1957."
  ask "Canteen lady" "Shall I look after your team?"
  yesno -> TMP
  if var TMP == 0 goto non
  close
  heal
  say "Canteen lady" "There you go! Everyone's in great shape. The coffee, however, is still lukewarm."
  goto fin
:non
  say "Canteen lady" "As you wish. But don't come crying at the next debate!"
:fin
end

script cantine_set_heal
  special set_heal_point
end

script shop_bxl
  special shop
end

script gare_guichet
  if !flag TRAIN_UNLOCKED goto ferme
  say "Ticket clerk" "Hello! European station, one-stop counter. Your Interrail Pass, please… Perfect. Where are we going?"
  close
  special train
  goto fin
:ferme
  say "Ticket clerk" "Sorry, international trains are reserved for Interrail Pass holders. Apparently you can win one in Strasbourg."
:fin
end

# generic city flavour NPCs
script cantine_npc_bxl
  say "Civil servant" "I've been eating here since 1993. The menu has changed only once: when the euro arrived."
end
script cantine_npc_lux
  say "Banker" "Here, even the coffee is tax-resident somewhere else."
end
script cantine_npc_ffm
  say "Economist" "The price of a sandwich has gone up 12% since 2021. My model predicted 2%. My model is hungry."
end
script cantine_npc_stras
  say "Parliamentary assistant" "Four days a month here, the rest in Brussels. My houseplants don't recognise me any more."
end
script cantine_npc_athenes
  say "Waitress" "An iced frappé? It's the only thing the Troika never managed to reform."
end
script cantine_npc_londres
  say "Gentleman" "We used to complain about Brussels. Now we complain that we can't complain about Brussels any more."
end
script cantine_npc_budapest
  say "Student" "Here we eat goulash. And we debate, discreetly."
end
script cantine_npc_paris
  say "Philosopher" "I think, therefore I lunch. And I lunch for a long time: this is Paris."
end
script shop_npc_bxl
  say "Customer" "I'm looking for a charger… Oh no, that's right, it's USB-C everywhere now. What bliss."
end
script shop_npc_lux
  say "Customer" "Prices exclude VAT. Obviously."
end
script shop_npc_ffm
  say "Shopper" "I pay for everything in cash. Germans love cash."
end
script shop_npc_stras
  say "Customer" "I've come to buy Stamps. My boss wants to stamp the clock change Euromon."
end
script shop_npc_athenes
  say "Shopper" "Everything's half price! Oh no, it's the VAT that has doubled."
end
script shop_npc_londres
  say "Shopper" "Is the price in pounds, in euros, or in election promises?"
end
script shop_npc_budapest
  say "Customer" "The shopkeeper asked my opinion of the government. I said: “veto”."
end
script shop_npc_paris
  say "Shopper" "A baguette, a Stamp, and a protest march, please."
end
script gare_npc_bxl
  if flag POSTGAME goto oliver
  say "Traveller" "My train to Strasbourg is four hours late. So is Parliament, for that matter."
  goto fin
:oliver
  if flag OLIVER_REJOIN goto fin2
  show R oliver happy
  say "Oliver" "{P}! Surprise! I took the Eurostar. With a passport, a form and two hours of queuing. I've come to ask… to come back. Rejoin?"
  say "Oliver" "But first, a debate. Like in the good old days!"
  close
  hide all
  if var STARTER == 1 goto c
  if var STARTER == 2 goto a
  battle oliver5_v nolose
  goto suite
:c
  battle oliver5_c nolose
  goto suite
:a
  battle oliver5_a nolose
:suite
  setflag OLIVER_REJOIN
  show R oliver happy
  say "Oliver" "What an internship! Apparently, to rejoin you have to negotiate 35 chapters. I start tomorrow. Cheers, {P}!"
  goto fin
:fin2
  show R oliver happy
  say "Oliver" "Chapter 1 of 35: “free movement of goods”. We're getting there!"
:fin
end
script gare_npc_lux
  say "Passenger" "In Luxembourg, public transport has been free since 2020. Even for interns!"
end
script gare_npc_ffm
  say "Passenger" "I commute Frankfurt–Brussels. I know every cow on the line by name."
end
script gare_npc_stras
  say "Traveller" "These iron trunks all belong to MEPs. They travel more than I do."
end
script gare_npc_athenes
  say "Passenger" "The train to Piraeus? Cancelled. Apparently someone bought the port."
end
script gare_npc_londres
  say "Traveller" "The Eurostar now requires a passport. We took back control. Of the queues."
end
script gare_npc_budapest
  say "Passenger" "The Danube flows through ten countries. I'm just trying to cross one without a check."
end
script gare_npc_paris
  say "Traveller" "Strike at the railways. Oh no, it's just Tuesday."
end
script gare_npc_anvers
  say "Docker" "Antwerp, Europe's second-biggest port. We see everything go by. Even tariffs."
end
script gare_npc_varsovie
  say "Traveller" "It's so cold without gas that the penguins are asking for asylum."
end
script gare_npc_rome
  say "Passenger" "All roads lead to Rome. So do the trains, late."
end
script gare_npc_maastricht
  say "Traveller" "This is where the treaty was signed in 1992. The sun was shining. It was the only time."
end
script gare_npc_lisbonne
  say "Passenger" "Lisbon, 2007: we signed a treaty that looked a lot like a Constitution. Shh."
end

script fete_europe
  setflag FETE_EUROPE
  music ending
  say - "Today is 9 May: Europe Day! Flags are flying all over the European quarter."
  say - "A rare Euromon, drawn by the festivities, leaps out of a pile of files!"
  wild schumark 25
  say - "Happy Europe Day! See you next year."
end
