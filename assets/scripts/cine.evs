# ---------------------------------------------------------------- Cinematics (slides + dialogue)
# slide <name> [still|zoom_in|zoom_out|pan_right|pan_left|tilt_up|tilt_down] [fade|cut|flash|iris|wipe]
# Slides with an _alex/_max version pick the player's one automatically.

script cine_prologue
  cine "Prologue — 9 May 1950"
  card "9 May 1950" "Paris, Quai d'Orsay, 6 p.m."
  slide s00_prologue_01_salon zoom_in fade
  say "Robert Schuman" "Gentlemen, thank you for coming. I'll be brief. Well… I'll try."
  say "Journalist" "(whispering) He says that every time."
  slide s00_prologue_02_monnet pan_left cut
  say "Jean Monnet" "(whispering) Robert. The sentence about coal. Don't forget the sentence about coal."
  say "Robert Schuman" "“The French Government proposes that Franco-German production of coal and steel as a whole be placed under a common High Authority.”"
  say "Journalist" "Coal? Steel? We missed the aperitif for this?"
  slide s00_prologue_03_acier zoom_out fade
  say - "Five years after the war, the idea is simple and crazy: pool what is used to make cannons."
  say - "So that war becomes “not merely unthinkable, but materially impossible”."
  slide s00_prologue_04_carte pan_right fade
  say - "Six countries in 1951. Then nine, twelve, fifteen, twenty-five… Twenty-seven today."
  say - "And every morning, somewhere in Brussels, an intern wakes up late."
  card "Chapter 1" "Brussels"
  slide s01_reveil_01_reveil zoom_in iris
  say - "Monday. Your alarm clock says 6:58. Your phone, 7:58. One of them wasn't told about the clock change."
  say "{P}" "FIRST DAY OF THE INTERNSHIP!"
  slide s01_reveil_02_course pan_right wipe
  say - "Rue de la Loi. One croissant, three files, zero dignity."
  say "Cyclist" "Cycle lane! Even interns respect Regulation 2019/1242! Well, I think it exists."
  slide s01_reveil_03_esplanade pan_left fade
  say "Oliver" "{P}! First day, and already an hour late. I've been here since 6:58. London time, of course."
  say "Oliver" "Professor Schuman is waiting for us in the Parliament hall. I told him you were ill. You'll thank me later."
  cine end
end

script cine_lux
  if flag CINE_LUX goto fin
  setflag CINE_LUX
  cine "Chapter 2 — Luxembourg"
  card "Chapter 2" "Luxembourg"
  slide s03_luxembourg_01_viaduc pan_right fade
  say - "The Adolphe Bridge spans the Pétrusse valley. Below, gardens. Above, banks. In the middle, your train."
  slide s03_luxembourg_02_bise zoom_in fade
  say "Jean-Claude Juncker" "Ah, the little Englishman! Come here and let me kiss you!"
  say "Oliver" "Sir, I… we don't do that. In England, we shake hands. From a distance. With gloves."
  say "Jean-Claude Juncker" "This is Luxembourg. We kiss on the cheek, we pat the cheek, and we speak four languages in the same sentence. Moien, bonjour, guten Tag, hello!"
  say "Oliver" "Help!"
  slide s03_luxembourg_03_arene tilt_up fade
  say "Jean-Claude Juncker" "My Golden Arena is in Kirchberg, intern. Come whenever you like. I pat cheeks for free. It's the only free service in the district."
  cine end
:fin
end

script cine_schengen
  if flag CINE_SCHENGEN goto fin
  setflag CINE_SCHENGEN
  cine "Schengen, three borders"
  slide s04_schengen_01_bateau pan_right fade
  say - "Schengen. Here, France, Germany and Luxembourg touch at the tips of their vines."
  say "Captain" "On 14 June 1985, five countries signed here, on a boat, the agreement abolishing border checks. On a river that IS a border. We love irony on the Moselle."
  slide s04_schengen_02_barriere zoom_out fade
  say "Customs officer" "Thirty years I've been stamping passports. And now? Butterflies cross without a visa."
  say "Customs officer" "I'm going to retrain. Postcard stamper. It's a market with a future."
  cine end
:fin
end

script cine_ffm
  if flag CINE_FFM goto fin
  setflag CINE_FFM
  cine "Chapter 3 — Frankfurt"
  card "Chapter 3" "Frankfurt am Main"
  slide s05_bce_01_tour tilt_up fade
  say - "Frankfurt, at night. Two glass towers, a euro sign as big as a bus. The European Central Bank never sleeps. It keeps an eye on inflation."
  slide s05_bce_02_levier zoom_in fade
  say "Christine Lagarde" "See this lever? The key interest rate. I raise it, prices calm down. I lower it, the economy breathes."
  say "Christine Lagarde" "I touch it by mistake with my elbow, and three governments fall. So I never lean on the desk."
  slide s05_bce_03_pluie zoom_out flash
  say "Oliver" "IT'S RAINING EUROS! Is this quantitative easing?!"
  say "Security guard" "No, sir. The air conditioning blew the banknotes out of the exhibition. Give them back. All of them. I'm counting."
  cine end
:fin
end

script cine_stras
  if flag CINE_STRAS goto fin
  setflag CINE_STRAS
  cine "Chapter 4 — Strasbourg"
  card "Chapter 4" "Strasbourg"
  slide s06_strasbourg_01_malles pan_right fade
  say - "Once a month, Parliament moves from Brussels to Strasbourg. With its MEPs, its assistants… and thousands of trunks."
  say "Member of Parliament" "My trunk has attended more plenary sessions than I have. It even has a seat on the transport committee."
  slide s06_strasbourg_02_hemicycle zoom_in fade
  say "Roberta Metsola" "The sitting is open! …Where are the MEPs?"
  say "Usher" "Madam President, they're still looking for their trunks on the platform."
  say "Roberta Metsola" "Then we'll vote by show of hands. Do trunks have the right to vote? No? Pity, at least they're on time."
  cine end
:fin
end

script cine_athenes
  if flag CINE_ATHENES goto fin
  setflag CINE_ATHENES
  cine "Chapter 5 — Athens"
  card "Chapter 5" "Athens"
  slide s07_athenes_01_acropole pan_left fade
  say - "The Acropolis at sunset. Two thousand five hundred years of democracy, philosophy… and meetings that finish late."
  slide s07_athenes_02_moto zoom_in fade
  say "Troika agent (ECB)" "Mr Varoufakis, your plan does not comply with our spreadsheets."
  say "Yanis Varoufakis" "Your spreadsheets don't comply with reality. I propose a debate. By motorbike, if you can keep up."
  say "Troika agent (IMF)" "We don't do motorbikes. We do recommendations."
  say "Yanis Varoufakis" "Then recommend yourselves to move aside. I have an arena waiting for me."
  cine end
:fin
end

script cine_londres
  if flag CINE_LONDRES goto fin
  setflag CINE_LONDRES
  cine "Chapter 6 — London"
  card "Chapter 6" "London"
  slide s08_brexit_01_pluie pan_right fade
  say - "London, in the rain. As usual. But this time, something heavier hangs in the air."
  slide s08_brexit_02_farage zoom_in fade
  say "Nigel Farage" "A pint for everyone! And a bus for the campaign! Never mind what we write on it, people will read the bus, not the footnotes."
  slide s08_brexit_03_tyrolienne pan_left fade
  say "Boris Johnson" "Don't panic! I'm stuck on a zip line, but it's a strategy. Get Brexit done! And somebody, a ladder, please."
  cine end
:fin
end

script cine_brexit
  cine "The referendum"
  slide s08_brexit_04_urne zoom_in fade
  say - "23 June 2016. 51.9% of voters choose to leave the European Union."
  say - "On 31 January 2020 at midnight Brussels time — 11 p.m. in London — the United Kingdom is no longer a member of the Union."
  slide s08_brexit_05_adieu zoom_in fade
  say "Oliver" "You know what's weird? I didn't want to be here at the start. I just wanted to win."
  say "Oliver" "And now I have to leave, and I don't want to any more. Ironic, isn't it?"
  say "{P}" "You'll come back. There's Erasmus, exchanges, student visas…"
  say "Oliver" "Erasmus? We left that too. But I'll find a way. The English always find a way back to Europe. It's called holidays."
  cine end
end

script cine_budapest
  if flag CINE_BUDAPEST goto fin
  setflag CINE_BUDAPEST
  cine "Chapter 7 — Budapest"
  card "Chapter 7" "Budapest"
  slide s09_budapest_01_danube pan_right fade
  say - "The Hungarian Parliament, golden on the Danube. The largest building in the country. And the largest collection of “VETO” stamps in Europe."
  slide s09_budapest_02_veto zoom_in fade
  say "Viktor Orbán" "European budget? Veto. Aid to Ukraine? Veto. New colour for Council badges? Veto. On principle."
  say "Special adviser" "Prime Minister, that was your lunch order."
  say "Viktor Orbán" "…Veto anyway. I don't like people deciding for me."
  cine end
:fin
end

script cine_magyar
  cine "12 April 2026"
  slide s09_budapest_03_foule zoom_out fade
  say "Péter Magyar" "Hungarians! Tonight, we did not win against Europe, nor against our neighbours. We won for ourselves!"
  say "Crowd" "TISZA! TISZA! TISZA!"
  slide s09_budapest_04_boude zoom_in fade
  say "Viktor Orbán" "…"
  say "Viktor Orbán" "I'm not sulking. I'm thinking. With my back turned. With a cloud over my head. It's very different."
  cine end
end

script cine_qatargate
  cine "December 2022 — dawn"
  slide s10_qatargate_01_aube pan_left fade
  say - "Brussels, December 2022. At dawn, Belgian police carry out searches around Place Lux."
  slide s10_qatargate_02_billets zoom_in flash
  say "Police officer" "Chief, there are bags. With banknotes in them. Lots of banknotes."
  say "Police chief" "Count them. And don't touch the football, it might be evidence."
  slide s10_qatargate_03_pris zoom_out fade
  say - "Parliament officials and people close to them are arrested. The investigation concerns possible corruption on behalf of foreign states."
  say - "Everyone implicated is presumed innocent until finally convicted."
  say "The Chief Lobbyist" "(in the distance) We have nothing to do with that. We pay in canapés. It's more discreet."
  cine end
end

script cine_dgcomp
  if flag CINE_DGCOMP goto fin
  setflag CINE_DGCOMP
  cine "DG Competition"
  slide s11_dgcomp_01_amende zoom_in fade
  say "Margrethe Vestager" "One more fine. I sign, I smile, I knit an elephant. It's very soothing."
  say "Competition lawyer" "Commissioner, the digital giants are asking for an extension."
  say "Margrethe Vestager" "Granted. They have until… now."
  slide s11_dgcomp_02_dsa pan_right fade
  say "Thierry Breton" "The Digital Services Act applies to everyone, Mr Musk. Even to networks that change their name every six months."
  say "Elon Musk" "I'm replying with a meme. That's my official legal position."
  say "Thierry Breton" "I'm replying with a four-page letter. That's mine."
  say - "They each pull on one end of the phone. The phone, meanwhile, says “low battery”."
  cine end
:fin
end

script cine_tour
  if flag CINE_TOUR goto fin
  setflag CINE_TOUR
  cine "The Tower of Ghost Assistants"
  slide s12_tour_01_couloir zoom_in iris
  say - "Thanks to the OLAF badge, the invisible becomes visible. Translucent assistants float down the corridor, payslip in hand."
  say "Ghost assistant" "Hello… I've worked here since 2009… Well, my contract works here… I've never actually come…"
  slide s12_tour_02_sommet zoom_in fade
  say "Ghost assistant" "My employers are up there. They say they don't know me. That's hurtful, for a ghost."
  say "François Bayrou" "(behind the door) I'm not here. And if I am, it's given the benefit of the doubt."
  cine end
:fin
end

script cine_paris
  if flag CINE_PARIS goto fin
  setflag CINE_PARIS
  cine "Chapter 9 — Paris"
  card "Chapter 9" "Paris"
  slide s13_paris_01_seine pan_right fade
  say - "Paris at golden hour. The Eiffel Tower, the Seine, and somewhere, a speech that begins and never ends."
  slide s13_paris_02_discours tilt_up fade
  say "Emmanuel Macron" "Europe must be sovereign! Powerful! Humanist! And I would even add, if you'll allow me, and I'm going to allow myself…"
  say "Student" "How long has he been talking?"
  say "Another student" "One hour forty. He's just finished the introduction."
  slide s13_paris_03_memetemps zoom_out flash
  say "Emmanuel Macron" "I am for rigour AND for investment. For openness AND for protection. I agree with you AND with your opponent."
  say "{P}" "What's that called?"
  say "Emmanuel Macron" "“At the same time”. It's patented. Well, at the same time, it's royalty-free."
  cine end
:fin
end

script cine_sofagate
  cine "April 2021 — Ankara"
  slide s14_sofagate_01_fauteuils zoom_in fade
  say - "April 2021, Ankara. Three leaders enter the room. There are two armchairs."
  say "Ursula von der Leyen" "Um."
  say "Charles Michel" "(already seated) Oh. Oh no. I've just realised."
  slide s14_sofagate_02_canape zoom_out fade
  say "Ursula von der Leyen" "No, no, don't get up. I'm perfectly fine on this sofa. It's long. It's beige. It's far away."
  say - "The incident went around the world as “Sofagate”. Since then, Charles Michel counts the chairs before entering anywhere."
  cine end
end

script cine_conseil
  if flag CINE_CONSEIL goto fin
  setflag CINE_CONSEIL
  cine "Chapter 10 — The European Council"
  card "Chapter 10" "The night of the European Council"
  slide s15_conseil_01_lanterne zoom_in fade
  say - "The Europa building. In its glass lantern, the heads of state and government meet. Summits start at 3 p.m. They end… later."
  slide s15_conseil_02_table pan_right fade
  say "António Costa" "Dear colleagues, it is 4:12 a.m. We still have one comma to settle in paragraph 37."
  say "Angela Merkel" "I've known summits where we negotiated a comma until breakfast. It was a very beautiful comma."
  say "Mario Draghi" "I propose a comma. Whatever it takes."
  say "Kaja Kallas" "I propose we order more pizzas before someone proposes a semicolon."
  slide s15_conseil_03_cloche zoom_in flash
  say "António Costa" "AGREEMENT! It's 5:03 a.m. The conclusions are adopted. Can someone wake the Prime Minister sleeping under the table?"
  cine end
:fin
end

script cine_champion
  cine "The 13th floor"
  slide s16_champion_01_berlaymont tilt_up fade
  say - "The Berlaymont at sunset. Thirteen floors. On the top one, the President of the Commission is waiting."
  slide s16_champion_02_bureau zoom_in fade
  say "Ursula von der Leyen" "Charles, can you stop sulking? It's been five years."
  say "Charles Michel" "I'm not sulking. I'm looking at the wall. It's very interesting, this wall. It has no armchair."
  say "Ursula von der Leyen" "{P}. There you are at last."
  slide s16_champion_03_duel zoom_in flash
  say "Ursula von der Leyen" "You want the directive? Beat me. Team Europe — in the end, there can be only one."
  cine end
end

script cine_pantheon
  cine "The interns' wall"
  slide s16_champion_04_pantheon pan_right fade
  say - "On the 13th floor, a long corridor displays photos of every Commission intern. Nobody ever looks at them."
  say - "Today, a new golden frame has just been hung. And for once, someone stops to look at it."
  cine end
end

script cine_puissances
  cine "Chapter 11 — The Great Powers"
  card "Chapter 11" "The Great Powers"
  slide s17_puissances_01_airforce pan_right fade
  say - "Port of Antwerp. A presidential plane lands. The seagulls, cautious, fly off towards the Netherlands."
  slide s17_puissances_02_tele zoom_in cut
  say "TV presenter" "Special edition! Washington, Moscow and Beijing are sending messages to Europe at the same time. The markets hesitate between panic and a nap."
  say "Café customer" "Again? I haven't even finished my waffle."
  say "Waiter" "It's a waffle, sir. Not a crisis. Unlike the Commission's inbox."
  slide s17_puissances_03_cargo pan_left fade
  say - "At the same moment, in Piraeus, a container ship the size of a city docks. Nobody knows exactly what it contains. Or what it's buying."
  cine end
end

script cine_anvers
  if flag CINE_ANVERS goto fin
  setflag CINE_ANVERS
  cine "Antwerp — the green"
  slide s18_anvers_01_golf zoom_in fade
  say "Donald Trump" "Look at this green. Between two containers. The most beautiful green in the history of ports."
  say "JD Vance" "Mr President, the golf bag is very heavy. Can we tax it?"
  say "Mark Rutte" "Magnificent shot, daddy! Er… Mr President!"
  slide s18_anvers_02_taxe zoom_out flash
  say "Donald Trump" "Every ball that leaves the United States pays a tariff. That one too. Especially that one. It fell into the Scheldt? VERY UNFAIR."
  cine end
:fin
end

script cine_varsovie
  if flag CINE_VARSOVIE goto fin
  setflag CINE_VARSOVIE
  cine "Warsaw — the snow"
  slide s19_varsovie_03_neige pan_left fade
  say "Donald Tusk" "The palace at the end of the plain? That's where he's waiting for you. Take a scarf. And a megaphone, for the table."
  say "Volodymyr Zelensky" "He'll tell you Europe is cold without him. Show him that Europe has learned to keep itself warm."
  cine end
:fin
end

script cine_poutine
  cine "The table"
  slide s19_varsovie_01_table pan_right fade
  say - "A white table. Very white. Very long. So long it has its own time zone."
  say "{P}" "(very loud) HELLO!"
  say - "…"
  say - "Three seconds later, the echo comes back from the other end of the room."
  slide s19_varsovie_02_regard zoom_in fade
  say "Vladimir Putin" "I hear you very well. It's you who are too close."
  cine end
end

script cine_piree
  if flag CINE_PIREE goto fin
  setflag CINE_PIREE
  cine "Piraeus"
  slide s20_piree_01_panda zoom_in fade
  say "Xi Jinping" "A gift. A plush panda. It symbolises the friendship between our peoples."
  say "{P}" "It's very cute. Thank you. …Why has the port just changed flags?"
  slide s20_piree_02_sceau zoom_out flash
  say "Xi Jinping" "Strategic partnership. You keep the panda. We keep the port. Everyone is happy."
  say "Greek docker" "I'd have preferred a real panda. It eats bamboo; at least it doesn't buy anything."
  cine end
:fin
end

script cine_gtout
  cine "The G-Everything Summit"
  slide s21_gtout_01_salle zoom_in fade
  say - "The G-Everything Summit. Three great powers. A single table. And a Europe that had been put on the folding seat."
  slide s21_gtout_02_triptyque pan_right cut
  say "Donald Trump" "Europe must choose: me."
  say "Vladimir Putin" "Europe must choose: me. Or the cold."
  say "Xi Jinping" "Europe can choose. We've already bought both options."
  cine end
end

script cine_gtout_fin
  cine "Europe stands up"
  slide s21_gtout_03_debout tilt_up flash
  say "{P}" "Europe doesn't choose a master. It chooses to stay together. Twenty-seven countries, twenty-four languages, one table. Ours."
  slide s21_gtout_04_sortie zoom_out fade
  say "Donald Trump" "I'm leaving. It was ME who decided to leave. Nobody beat me."
  say "Vladimir Putin" "I'm leaving too. The door was too close to me anyway."
  say "Xi Jinping" "We are leaving. But we remain partners. And competitors. And rivals. Good evening."
  say - "Three doors slam. Three great powers sulk. And in the room, interns applaud."
  cine end
end

script cine_fin
  cine "Epilogue"
  card "Epilogue" "Brussels, the evening the internship ends"
  slide s22_fin_01_grandplace tilt_up fade
  say - "Grand-Place in Brussels. Blue and gold fireworks draw twelve stars above the town hall."
  slide s22_fin_02_diplome zoom_in fade
  say "Professor Schuman" "{P}, on behalf of all the institutions, here is your internship certificate. It is signed, countersigned and translated into twenty-four languages."
  say "Professor Schuman" "The Maltese version has a typo. It's tradition."
  slide s22_fin_03_retour zoom_in flash
  say "Oliver" "{P}! WAIT! Don't start without me!"
  say "{P}" "Oliver?! But… how?"
  say "Oliver" "Youth mobility visa, insurance, two forms, three stamps. A real paperwork Euromon. I'm back. As a tourist. But back!"
  slide s22_fin_04_photo pan_right fade
  say "Jean-Claude Juncker" "Group photo! Everyone squeeze in! I'll pat cheeks afterwards."
  say "Nigel Farage" "I'll be in the photo only if nobody tells anyone I was in the photo."
  say "Viktor Orbán" "(off camera) Veto on the photo."
  say "Péter Magyar" "He doesn't have a veto any more. Smile!"
  slide s22_fin_05_ciel zoom_out fade
  say "Jean Monnet" "“We are not forming coalitions of states, we are uniting people.” Men, women, and interns."
  say "Robert Schuman" "Concrete achievements. De facto solidarity. Well done, kid. And now… off to bed. Tomorrow, there's a coordination meeting about meetings."
  cine end
end

script cine_rome
  cine "Rome, 25 March 1957"
  slide s23_legendes_01_rome zoom_in fade
  say - "Capitol Square. On 25 March 1957, six countries signed the Treaties of Rome here. The stone remembers. It begins to glow."
  cine end
end

script cine_maastricht
  cine "Maastricht, 7 February 1992"
  slide s23_legendes_02_maastricht pan_right fade
  say - "The Meuse, at night. Here the European Union was born, and the idea of a single currency. Glowing coins rise to the surface of the water."
  cine end
end

script cine_lisbonne
  cine "Lisbon, 13 December 2007"
  slide s23_legendes_03_lisbonne tilt_up fade
  say - "Dawn over the Tagus. In front of the Jerónimos Monastery, treaty pages begin to float, then to fly."
  cine end
end
