# ---------------------------------------------------------------- Athènes
script ath_sign
  say - "Athens. Cradle of democracy, of philosophy… and of the referendum of 5 July 2015."
end
script ath_touriste
  say "Tourist" "The Acropolis is 2,500 years old. It survived the Persians, the Ottomans and the Troika."
end
script piree_guard
  say "Greek customs officer" "The port of Piraeus? Closed to visitors. It belongs to… partners. Very much partners."
end
script piree_block
  say "Greek customs officer" "Sorry, port access is restricted. Come back when the situation is… more diplomatic."
  move player "D"
end
script gym4_t1
  say "Nikos" "In 2015, I voted OXI. And afterwards… it's complicated."
end
script gym4_t2
  say "Troika agent (ECB)" "Our report recommends even more austerity. Even for your Euromons."
end
script gym4_t3
  say "Troika agent (IMF)" "We acknowledge a few errors in our forecasts. Between us."
end
script gym4_leader
  if flag BADGE_4 goto apres
  show R varoufakis neutral
  say "Yanis Varoufakis" "Here for a badge? I came here by motorbike, in a leather jacket, no tie. Like at the Eurogroup meetings in 2015."
  expr R happy
  say "Yanis Varoufakis" "Finance minister for six months. I resigned after the referendum: 61% for OXI. Democracy is beautiful, and stubborn."
  expr R angry
  say "Yanis Varoufakis" "The Troika was waiting for me. You beat its agents. Show me if you're stronger than austerity!"
  close
  hide all
  battle varoufakis
  show R varoufakis happy
  say "Yanis Varoufakis" "NAI! Er, I mean: well done. Here's the OXI Badge, comrade."
  badge 4
  setflag TRAIN_LONDRES
  chapter 5
  say "Yanis Varoufakis" "Your next badge is in London. But hurry: over there, there's more and more talk of a certain exit door."
  goto fin
:apres
  show R varoufakis happy
  say "Yanis Varoufakis" "I'm off to give another lecture. On debt. On a motorbike."
:fin
end

# ---------------------------------------------------------------- Londres (Brexit)
script lon_sign
  say - "Westminster. Here, on 23 June 2016, the United Kingdom voted by 51.9% to leave the European Union."
end
script lon_garde
  say "Royal guard" "…"
  say "Royal guard" "…"
  say "Royal guard" "(He doesn't move. Not even for Brexit.)"
end
script gym5_t1
  say "Editor-in-chief" "Tomorrow's headline: cucumbers that are too straight. It's worked for twenty years."
end
script gym5_johnson
  show R johnson happy
  say "Boris Johnson" "In the 1990s, I was the Daily Telegraph's Brussels correspondent. I wrote some… imaginative things. Get Brexit done!"
end
script gym5_leader
  if flag BADGE_5 goto apres
  show R farage happy
  say "Nigel Farage" "Welcome to the pub! A pint? I spent twenty years in the European Parliament explaining that we shouldn't be there."
  expr R angry
  say "Nigel Farage" "On 28 June 2016, I told the MEPs: “You're not laughing now, are you?” They didn't laugh. You won't laugh either."
  close
  hide all
  battle farage
  show R farage worried
  say "Nigel Farage" "Right. You won. Take this Article 50 Badge. We've already used ours."
  badge 5
  chapter 6
  hide all
  call brexit_event
  goto fin
:apres
  show R farage happy
  say "Nigel Farage" "Still here? We've left, you know."
:fin
end

script brexit_event
  setflag BREXIT_DONE
  clearflag TRAIN_LONDRES
  setflag TRAIN_BUDAPEST
  music sad
  call cine_brexit
  show L oliver worried
  say "Oliver" "I have to go home. I'm no longer allowed to be an intern at Parliament. But before that… one last debate. For honour."
  close
  hide all
  if var STARTER == 1 goto c
  if var STARTER == 2 goto a
  battle oliver4_v nolose
  goto fin
:c
  battle oliver4_c nolose
  goto fin
:a
  battle oliver4_a nolose
:fin
  show L oliver worried
  say "Oliver" "Thank you, {P}. Keep an eye on the directive for me. And on summer time. Back home, we'll never change it, of course."
  say "Oliver" "Goodbye. Or rather… see you later. Who knows?"
  hide all
  say - "Oliver is gone. The London train will no longer appear at the ticket office. Next stop: Budapest, on the Danube."
end

# ---------------------------------------------------------------- Budapest
script bud_sign
  say - "Országház, the Hungarian Parliament, on the banks of the Danube. The largest building in Hungary. And the largest veto."
end
script bud_magyar_npc
  if flag BADGE_6 goto apres
  say "Young Hungarian woman" "They say the opposition is gaining ground. A certain Péter Magyar is campaigning all over the country."
  goto fin
:apres
  show R magyar happy
  say "Péter Magyar" "Hungarians voted on 12 April 2026. My party, Tisza, won a two-thirds majority. A new page is turning!"
:fin
end
script gym6_t1
  say "Gábor" "We built a fence. It's mostly used for photos."
end
script gym6_t2
  say "Special adviser" "The Prime Minister is about to step out for a coffee. It's a negotiating technique."
end
script gym6_leader
  if flag BADGE_6 goto apres
  show R orban neutral
  say "Viktor Orbán" "Looking for an agreement? Here, unanimity is required. And I never agree."
  expr R happy
  say "Viktor Orbán" "In 2024, I held the Presidency of the Council of the Union with the slogan “Make Europe Great Again”. Ring any bells?"
  expr R angry
  say "Viktor Orbán" "In my arena, I can use my VETO every turn. And sometimes… I step out for a coffee. Like in December 2023, during the vote on Ukraine."
  close
  hide all
  battle orban
  show R orban worried
  say "Viktor Orbán" "…Fine. I abstain. Take this Veto Badge. Officially, I wasn't in the room."
  badge 6
  chapter 7
  hide all
  say - "A few months later, on 12 April 2026, Hungarians vote. Péter Magyar's Tisza party wins with a two-thirds majority."
  call cine_magyar
  show L magyar happy
  say "Péter Magyar" "Orbán acknowledged his defeat: “painful, but clear”. Thank you, intern. Go back to Brussels: apparently DG Competition has a… lobby problem."
  setflag TRAIN_BRUXELLES
  goto fin
:apres
  show R orban sulk
  say "Viktor Orbán" "I've stepped out for a coffee. Come back later. Much later."
:fin
end

# ---------------------------------------------------------------- Team Lobby (place Lux)
script lux_barman
  say "Bartender" "On Place Lux, on Thursday evenings, the whole of Brussels comes for a drink. MEPs, assistants… and lobbyists. Especially lobbyists."
end
script lux_guard
  if !flag BADGE_6 goto ferme
  if flag LOBBY_DEFEATED goto fin
  if flag CINE_QATARGATE goto vu
  setflag CINE_QATARGATE
  call cine_qatargate
:vu
  say "Lobbyist" "The basement? Members only. Are you on the transparency register? No? Me neither. Come on in."
  goto fin
:ferme
  say "Lobbyist" "Move along, intern. Here, the grown-ups are talking business."
  move player "D"
:fin
end
script lobby_t1
  say "Oil lobbyist" "The energy transition? We support it. From 2080 onwards."
end
script lobby_t2
  say "Tech lobbyist" "We respect the GDPR. We even have a 47-page cookie banner."
  ask "Tech lobbyist" "I bet you can't refuse them all. Nobody can. Shall we try?"
  yesno -> TMP
  if var TMP == 0 goto fin
  close
  minigame cookies
  if var RESULT == 0 goto rate
  if flag COOKIES_DONE goto deja
  setflag COOKIES_DONE
  say "Tech lobbyist" "Impossible… You refused everything?! Fine. Here's a legal opinion. Free of charge. Don't tell anyone."
  giveitem avis_juridique 3
  goto fin
:deja
  say "Tech lobbyist" "You again! Our banners don't stand a chance."
  goto fin
:rate
  say "Tech lobbyist" "Thanks for accepting our 437 partners! Your data is in good hands. Ours."
:fin
end
script lobby_t3
  say "Lobbyist" "The suitcases? They're documentation suitcases. Very well documented."
end
script lobby_kaili
  show R kaili worried
  say "Eva Kaili" "In December 2022, Belgian police found bags of banknotes in several flats in Brussels. It was called “Qatargate”."
  say "Eva Kaili" "I was Vice-President of Parliament. I have always contested the accusations. As of this game, no final judgment has been handed down in this case."
  hide all
  say - "Note: anyone implicated is presumed innocent until proven guilty."
end
script lobby_chef
  if flag LOBBY_DEFEATED goto fin
  say "The Chief Lobbyist" "Well, well. The intern. Do you know how many of us there are in Brussels? 25,000. And you are one."
  say "The Chief Lobbyist" "Your daylight saving directive? I have clients who sell clocks. It will stay blocked. Unless…"
  close
  battle lobbychef
  say "The Chief Lobbyist" "Well played. I am officially declaring my defeat in the transparency register. And I'm off to the private sector. Oh, I'm already there."
  setflag LOBBY_DEFEATED
  hidenpc chef_lobby
  sfx DOOR
  say - "Team Lobby scatters. DG Competition's investigations can resume!"
:fin
end

# ---------------------------------------------------------------- DG COMP (Vestager)
script gym7_t1
  say "Big Tech lawyer" "We will appeal. Then appeal the appeal."
end
script gym7_t2
  say "Competition lawyer" "Abuse of a dominant position… “Abuse” is a strong word."
end
script gym7_leader
  if flag BADGE_7 goto apres
  show R vestager happy
  say "Margrethe Vestager" "Thank you for ridding us of Team Lobby. My files are finally moving!"
  expr R neutral
  say "Margrethe Vestager" "Google: €2.4 billion fine in 2017, €4.3 billion in 2018. Apple: €13 billion of tax aid to repay, confirmed by the Court in 2024."
  say "Margrethe Vestager" "Does your team respect competition rules? I'm going to check. Personally."
  close
  hide all
  battle vestager
  show R vestager happy
  say "Margrethe Vestager" "No infringement found. The Fine Badge is yours. And take this too: the OLAF badge, from the Anti-Fraud Office."
  badge 7
  giveitem badge_olaf
  setflag OLAF_BADGE
  chapter 8
  expr R worried
  say "Margrethe Vestager" "There are reports of… strange presences in one wing of Parliament. Assistants nobody ever sees. With this badge, you'll see them."
  goto fin
:apres
  show R vestager happy
  say "Margrethe Vestager" "No fine for you today. Enjoy it."
:fin
end

# ---------------------------------------------------------------- Tour des assistants fantômes
script tour_entry
  if flag OLAF_BADGE goto voir
  say - "A cold corridor… You can hear keyboards typing by themselves. But there's nobody there. You'd need a way to see the invisible."
  say - "Better go back down for now."
  warp parlement_hall 14 3 down
  goto fin
:voir
  call cine_tour
:fin
end
script tour_t1a
  say "Ghost assistant" "My office? I never found it…"
end
script tour_t1b
  say "Ghost assistant" "I was paid to assist… a party. Not an MEP."
end
script tour_t2a
  say "Ghost assistant" "Boo… The clock change makes me appear twice a year…"
end
script tour_t2b
  say "Ghost assistant" "My contract says “local assistant”. Local to what? A mystery."
end
script tour_t3a
  say "Ghost assistant" "I'm disappearing… at last…"
end
script tour_t3b
  say "Ghost assistant" "Thank you… for freeing me from this contract…"
end
script tour_lepen
  show R lepen neutral
  say "Marine Le Pen" "The FN parliamentary assistants affair: the scheme paid party employees with European Parliament money."
  say "Marine Le Pen" "I was convicted at first instance on 31 March 2025, then on appeal on 7 July 2026: three years, one of them to be served under an electronic tag, and fifteen months of ineligibility."
  hide all
  say - "With this appeal sentence, her candidacy for the 2027 presidential election becomes theoretically possible again. A final appeal to the Court of Cassation remains possible."
end
script tour_bayrou
  show R bayrou neutral
  say "François Bayrou" "The MoDem assistants affair is something else. In February 2024, I was acquitted “given the benefit of the doubt”. The prosecution appealed."
  say "François Bayrou" "Then I was Prime Minister… from December 2024 to September 2025. Time flies at Matignon."
  hide all
  say - "Ghost assistants don't do politics: they haunt every party that misused them."
end
script tour_boss
  if flag GHOST_BOSS_DONE goto fin
  say "The Empty Contract" "I AM… THE SPIRIT OF EVERY CONTRACT WITHOUT AN OFFICE… OF EVERY PARTY… OF EVERY LEGISLATURE…"
  close
  battle fantome_boss
  setflag GHOST_BOSS_DONE
  hidenpc fant_boss
  say - "The Empty Contract dissolves in a cloud of payslips. The ghost wing is calm at last."
  say - "A message from Roberta Metsola arrives: “Thank you! The last badge awaits you in Paris, at the Sorbonne.”"
  setflag TRAIN_PARIS
  chapter 9
:fin
end

# ---------------------------------------------------------------- Paris
script par_sign
  say - "The Sorbonne. Here, Emmanuel Macron gave two major speeches on Europe, in 2017 and in 2024. The second one lasted almost two hours."
end
script par_touriste
  say "Tourist" "I asked for directions in English. They answered in French. With a smile. A very faint one."
end
script gym8_t1
  say "ENA graduate" "I wrote a briefing note on my defeat. It's 80 pages long."
end
script gym8_t2
  say "Junior minister" "I just got reshuffled during the battle. That's a record."
end
script gym8_leader
  if flag BADGE_8 goto apres
  show R macron happy
  say "Emmanuel Macron" "Welcome to the Sorbonne! Here, I spoke about a sovereign Europe in 2017. Then about a Europe that “could die”, in 2024."
  expr R neutral
  say "Emmanuel Macron" "In 2019, I said NATO was “brain-dead”. In 2024, I dissolved the National Assembly. I like… surprising decisions."
  expr R happy
  say "Emmanuel Macron" "So let's debate, and at the same time, let's think. Strategic autonomy!"
  close
  hide all
  battle macron
  show R macron happy
  say "Emmanuel Macron" "Magnificent! You have the makings of a great European. And at the same time, of an even greater one. The Sorbonne Badge is yours."
  badge 8
  chapter 10
  say "Emmanuel Macron" "With eight badges, the European Council awaits you at the Europa building in Brussels. Good luck: their summits rarely end before 5 a.m."
  goto fin
:apres
  show R macron happy
  say "Emmanuel Macron" "I'd happily talk to you about Europe for two hours, but you have a Council to convince."
:fin
end
