# ---------------------------------------------------------------- Route 1
script r1_sign
  say - "Route 1 — Ardennes Forest. Luxembourg: 3 hours on foot, 12 minutes by tax ruling."
end
script r1_rando
  say "Hiker" "The Ardennes forest stretches across three countries. The wild boars have never shown their passports."
end
script r1_t1
  say "Léa" "One day, we'll get paid. One day…"
end
script r1_t2
  say "Mr Dupont" "Don't forget to fill in the satisfaction form. It's 12 pages long."
end
script r1_t3
  say "Gérard" "The CAP is a third of the European budget. And my combine harvester is a third of my loan."
end

# ---------------------------------------------------------------- Luxembourg
script lux_sign
  say - "Luxembourg-Kirchberg. EU Court of Justice, Court of Auditors, European Investment Bank. And lots of plain old banks."
end
script lux_sign_schengen
  say - "To Schengen, the Moselle village where the 1985 agreement was signed. Follow the path south."
end
script lux_schengen
  if flag SCHENGEN_SEEN goto fin
  setflag SCHENGEN_SEEN
  say - "A little path leads down to the Moselle… and to Schengen."
:fin
  warp schengen 11 1 down
end
script lux_touriste
  say "Tourist" "Public transport is free here! I've been round the city 14 times by tram. For nothing. For free."
end
script lux_mamie
  say "Granny" "My husband was a European civil servant. He worked at the Court of Auditors. He even counted sheep to fall asleep."
end
script cjue_juge
  say "Judge" "The Court of Justice of the European Union has sat here since 1952. Our judgments bind all 27 states. Even on Monday mornings."
end
script cjue_greffier
  say "Registrar" "I translated a judgment into 24 languages. The Maltese version has a typo. Nobody has spotted it in ten years."
  ask "Registrar" "And here's today's pile. We need fifteen valid rulings stamped before the registry closes. Watch out, some bad documents have slipped in! Can you give me a hand?"
  yesno -> TMP
  if var TMP == 0 goto refus
  close
  minigame tampon
  if var RESULT == 0 goto rate
  if flag STAMP_DONE goto deja
  setflag STAMP_DONE
  say "Registrar" "Fifteen rulings, fifteen stamps! The Court thanks you. Take these qualified stamps, they work much better."
  giveitem tampon_qualifie 3
  goto fin
:deja
  call stamp_repeat_reward
  goto fin
:rate
  say "Registrar" "The registry cannot approve this pile. We need fifteen valid rulings and no bad documents stamped. Try again whenever you like."
  goto fin
:refus
  say "Registrar" "Never mind. I'll stamp them myself. In triplicate."
:fin
end
script lux_exit_block
  say "Luxembourg customs officer" "The Moselle road is reserved for holders of the Tax Ruling Badge. See Mr Juncker at the Golden Arena."
  move player "L"
end
script oliver_lux
  show R oliver neutral
  say "Oliver" "{P}! Still here? I've already visited three banks and opened two accounts. For the folklore."
  say "Oliver" "Debate!"
  close
  hide all
  if var STARTER == 1 goto c
  if var STARTER == 2 goto a
  battle oliver2_v
  goto fin
:c
  battle oliver2_c
  goto fin
:a
  battle oliver2_a
:fin
  setflag OLIVER_LUX_DONE
  show R oliver worried
  say "Oliver" "Fine, OK, you're improving. I'm off to Frankfurt to see the ECB. They promised to explain interest rates to me."
  hidenpc lux_oliver
end
script gym1_t1
  say "Pierre-Henri" "Here in Luxembourg, discretion is a virtue. And an industry."
end
script gym1_t2
  say "Counsel Klein" "Tax rulings were legal, you know. It's just that nobody was supposed to read them. LuxLeaks, 2014, what a misfortune."
end
script gym1_leader
  if flag BADGE_1 goto apres
  show R juncker happy
  say "Jean-Claude Juncker" "Ah, Schuman's little intern! Come, come. I started small too. Then I was Prime Minister for eighteen years."
  expr R neutral
  say "Jean-Claude Juncker" "I chaired the Eurogroup, then the Commission. I've seen my share of summits. And I've patted a lot of cheeks."
  expr R happy
  say "Jean-Claude Juncker" "Once, in 2011, I said: “When it becomes serious, you have to lie.” So I won't tell you I'm going to let you win."
  close
  hide all
  battle juncker
  show R juncker happy
  say "Jean-Claude Juncker" "Wonderful! You've won the Tax Ruling Badge. This one's official, not confidential!"
  badge 1
  setflag TRAIN_LUXEMBOURG
  chapter 2
  say "Jean-Claude Juncker" "The Moselle road is open to you. Frankfurt awaits, and Christine Lagarde doesn't joke about rates."
  goto fin
:apres
  show R juncker happy
  say "Jean-Claude Juncker" "Back to see me? Come here so I can pat your cheek. It's a Luxembourg tradition. Well, mine."
:fin
end

# ---------------------------------------------------------------- Schengen
script schengen_monument
  say - "Here, on 14 June 1985, aboard the boat Princesse Marie-Astrid, five countries signed the Schengen Agreement abolishing border checks."
end
script schengen_capitaine
  say "Captain" "The Princesse Marie-Astrid! It was on a boat like this that borders were abolished. Ironic, on a river that is one."
  say "Captain" "They say a rare Euromon, Schengeon, roams the village's files. It never stops at customs."
end

# ---------------------------------------------------------------- Route 2 / Francfort
script r2_sign
  say - "Route 2 — Moselle Valley. Three countries in twenty kilometres. Remember to switch languages."
end
script r2_t1
  say "Kevin" "Free roaming is the Union's greatest gift. I've posted 4,000 photos of the Moselle."
end
script r2_t2
  say "Hans" "According to my calculations, you'll win the next badge. But my calculations are rarely right."
end
script r2_t3
  say "Jean-Marc" "Luxembourg crémant is PDO! Like my Cheeson."
end
script ffm_sign_bce
  say - "European Central Bank. Mission: price stability. Inflation target: 2% over the medium term. Medium term: not specified."
end
script ffm_npc1
  say "Trader" "The markets are nervous. They're always nervous. It's their job."
end
script ffm_epargnant
  say "Saver" "I still have my mattress full of Deutschmarks. You never know."
end
script ffm_exit_block
  say "Guard" "The Rhine road is closed to interns without the Euro Badge. Go and see Ms Lagarde at the ECB."
  move player "U"
end
script gym2_t1
  say "Karl" "I was betting on your defeat. I lost my shirt. And my tie."
end
script gym2_t2
  say "Dr Sofia" "The shock was exogenous. Totally exogenous."
end
script gym2_leader
  if flag BADGE_2 goto apres
  show R lagarde neutral
  say "Christine Lagarde" "Welcome to the European Central Bank. Here, every word I say moves the markets. So I choose my words."
  expr R happy
  say "Christine Lagarde" "One day in March 2020, I said we were “not here to close spreads”. Italian markets plunged. You live and learn."
  expr R neutral
  say "Christine Lagarde" "In my arena, the power of my attacks follows the current key interest rate. Ready for a little monetary policy?"
  close
  hide all
  battle lagarde
  show R lagarde happy
  say "Christine Lagarde" "Remarkable. Your strategy was… predictable, in the good sense. Here is the Euro Badge."
  badge 2
  setflag TRAIN_FRANCFORT
  chapter 3
  say "Christine Lagarde" "Strasbourg is to the south, past the Rhine vineyards. Roberta Metsola presides over Parliament. Never interrupt her."
  goto fin
:apres
  show R lagarde happy
  say "Christine Lagarde" "Rates are stable today. Make the most of it, it never lasts."
  if flag BCE_VAULT_OPEN goto fin
  say "Christine Lagarde" "Between us: the euro became cash, in people's pockets, in 2002. Some doors in this tower still remember that year."
:fin
end
script oliver_ffm
  show R oliver neutral
  say "Oliver" "The ECB explained everything to me: inflation, rates, the balance sheet… I didn't understand a thing. Come on, a debate, to relax!"
  close
  hide all
  if var STARTER == 1 goto c
  if var STARTER == 2 goto a
  battle oliver3_v
  goto fin
:c
  battle oliver3_c
  goto fin
:a
  battle oliver3_a
:fin
  setflag OLIVER_FFM_DONE
  show R oliver worried
  say "Oliver" "Hmm. You know, back home in London, some people talk about leaving the Union. That would be ridiculous, wouldn't it? …Wouldn't it?"
  hidenpc ffm_oliver
end

# ---------------------------------------------------------------- Route 3 / Strasbourg
script r3_t1
  say "Inès" "The Green Deal was presented in December 2019. Since then, we've been fighting over every comma."
end
script r3_t2
  say "Tom" "My next article: “Commission wants to ban lost debates”. It's false, but it'll go viral."
end
script r3_t3
  say "Albert" "Alsace wine and Baden wine look at each other across the Rhine. It used to be cannons. Progress!"
end
script stras_sign
  say - "Strasbourg, official seat of the European Parliament. 12 plenary sessions a year. 720 MEPs. Thousands of trunks."
end
script stras_depute
  say "MEP" "I've done Brussels–Strasbourg twelve times a year since 2014. That makes… 132 moves. My trunks have more loyalty points than I do."
end
script stras_malles
  if flag MALLES_DONE goto fin
  say "Civil servant" "Help! The session starts in 2 minutes and the MEPs' trunks aren't loaded! Can you help me?"
  yesno -> TMP
  if var TMP == 0 goto refus
  close
  minigame malles
  if var RESULT == 0 goto rate
  setflag MALLES_DONE
  say "Civil servant" "All the trunks are on board! Here, take this, it's the logistics department's official reward."
  giveitem super_tampon 5
  goto fin
:rate
  say "Civil servant" "Missed… Oh well, we'll say the session is starting late. As usual. Try again whenever you like!"
  goto fin
:refus
  say "Civil servant" "Well… I'll go and cry in a trunk again."
:fin
end
script gym3_t1
  say "MEP Muller" "My 2,000 amendments… rejected en bloc. We'll have to start again in committee."
end
script gym3_t2
  say "MEP Rossi" "For the Lisbon Treaty, I had a whole trunk of notes. It stayed in Brussels."
end
script gym3_huissier
  say "Usher" "Silence in the hemicycle! Madam President only accepts debates after a vote. Would you like to attempt a plenary vote?"
  if flag VOTE_DONE goto deja
  yesno -> TMP
  if var TMP == 0 goto fin
  close
  minigame vote
  if var RESULT == 0 goto rate
  setflag VOTE_DONE
  say "Usher" "Adopted by a majority! The President will receive you."
  goto fin
:rate
  say "Usher" "Rejected… There was no quorum. Try again!"
  goto fin
:deja
  say "Usher" "Your vote has been recorded. The President is waiting for you."
:fin
end
script gym3_leader
  if flag BADGE_3 goto apres
  if !flag VOTE_DONE goto vote
  show R metsola neutral
  say "Roberta Metsola" "The sitting is open. President of Parliament since 2022, re-elected in 2024: I'm used to enforcing speaking time."
  expr R happy
  say "Roberta Metsola" "You have thirty seconds. Ah, time's already up. Right, let's debate!"
  close
  hide all
  battle metsola
  show R metsola happy
  say "Roberta Metsola" "The result is clear: adopted! The Hemicycle Badge is yours."
  badge 3
  setflag TRAIN_STRASBOURG
  setflag TRAIN_UNLOCKED
  setflag TRAIN_ATHENES
  chapter 4
  say "Roberta Metsola" "And here's the European Interrail Pass. With it, every station is open to you. Your next badge is in Athens."
  giveitem pass_interrail
  expr R worried
  say "Roberta Metsola" "They say Yanis Varoufakis teaches there… on a motorbike. Take the train at Strasbourg station."
  goto fin
:vote
  show R metsola neutral
  say "Roberta Metsola" "A debate? Not without a plenary vote. See the usher."
  goto fin
:apres
  show R metsola happy
  say "Roberta Metsola" "The next session is in a month. Don't forget your trunks!"
:fin
end
