# The five desk computers: each opens a mini-game, with a reward the first time it is won.
# The separate EU-branded machines open the Euromon archives via their PC tile behavior.

script studio_ordi
  ask - "Ton ordinateur. 437 courriels non lus clignotent dans un coin de l'écran."
  choice "Boîte mail" "Éteindre" -> TMP
  if var TMP == 1 goto fin
  close
  minigame courriels
  if var RESULT == 0 goto rate
  if flag PC_MAIL_DONE goto deja
  setflag PC_MAIL_DONE
  say - "Une notification s'affiche : « Félicitations pour votre productivité ! » Un colis t'attendait sous le bureau."
  giveitem x_reactivite 2
  goto fin
:deja
  say - "Boîte vide. Trois secondes plus tard : « Re: Réunion de coordination sur les réunions »."
  goto fin
:rate
  say - "Le serveur de messagerie affiche un sablier. Il l'affichera sans doute jusqu'à demain."
  goto fin
:fin
end

script parl_ordi
  ask - "Un ordinateur du service de presse. L'écran affiche : « Cellule Désinfox – rumeurs à vérifier : 2 384 »."
  choice "Désinfox" "Éteindre" -> TMP
  if var TMP == 1 goto fin
  close
  minigame desinfox
  if var RESULT == 0 goto rate
  if flag PC_INTOX_DONE goto deja
  setflag PC_INTOX_DONE
  say "Agent du Parlement" "Du beau travail de vérification ! Le service de presse t'offre ces rapports d'expert. Sourcés, eux."
  giveitem x_expertise 2
  goto fin
:deja
  say - "Toutes les rumeurs du jour sont vérifiées. Il en arrivera d'autres d'ici le déjeuner."
  goto fin
:rate
  say - "Une intox vient d'être partagée 40 000 fois. Le démenti, lui, 12 fois."
  goto fin
:fin
end

script cjue_ordi
  say - "Le terminal de la DG Traduction. Un voyant rouge clignote : « Messages en attente d'aiguillage »."
  ask "Greffier" "Les interprètes sont débordés ! Tu peux trier les messages et les envoyer à la bonne cabine ?"
  yesno -> TMP
  if var TMP == 0 goto fin
  close
  minigame langues
  if var RESULT == 0 goto rate
  if flag PC_LANG_DONE goto deja
  setflag PC_LANG_DONE
  say "Greffier" "Vingt-quatre langues, aucune erreur d'aiguillage ! Prends ce carnet d'adresses, tous les interprètes de la Cour y sont."
  giveitem x_diplomatie 2
  goto fin
:deja
  say "Greffier" "Tu reconnais le slovène du slovaque mieux que la moitié du Conseil."
  goto fin
:rate
  say "Greffier" "Un message maltais est arrivé en cabine irlandaise. Ils en discutent encore. Réessaie quand tu veux."
  goto fin
:fin
end

script bce_ordi
  say - "Un terminal Bloomberg, encore chaud. Sur un post-it : « Objectif : 2 %. Pas 1,9. Pas 2,1. 2. »"
  ask - "Prendre les commandes de la politique monétaire de la zone euro ?"
  yesno -> TMP
  if var TMP == 0 goto fin
  close
  minigame taux
  if var RESULT == 0 goto rate
  if flag PC_TAUX_DONE goto deja
  setflag PC_TAUX_DONE
  say - "Les marchés saluent ta prudence. Une prime de stabilité tombe sur ton compte !"
  money 3000
  goto fin
:deja
  say - "Inflation à 2 %. Quelque part à Francfort, un économiste verse une larme de joie."
  goto fin
:rate
  say - "Le terminal affiche un graphique en forme de montagnes russes. Personne n'a rien vu. Recommence vite."
  goto fin
:fin
end

script stras_ordi
  say - "L'ordinateur de l'eurodéputée. Sur le bureau, un enchevêtrement de 14 chargeurs différents."
  ask "Eurodéputée" "J'ai voté la directive USB-C ! Mais mes collègues ont encore de vieux appareils… Tu m'aides à les mettre en conformité ?"
  yesno -> TMP
  if var TMP == 0 goto fin
  close
  minigame usbc
  if var RESULT == 0 goto rate
  if flag PC_USBC_DONE goto deja
  setflag PC_USBC_DONE
  say "Eurodéputée" "Un seul chargeur pour tous ! Tiens, prends cette clé USB-C. Il paraît qu'elle fait évoluer certains Euromons numériques."
  giveitem cle_usb 1
  goto fin
:deja
  say "Eurodéputée" "Le tiroir à câbles est enfin vide. Je ne sais plus quoi y ranger."
  goto fin
:rate
  say "Eurodéputée" "Il reste des câbles Lightning partout… On réessaie quand tu veux."
  goto fin
:fin
end
