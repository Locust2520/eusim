# The five desk computers: each opens a mini-game, with a reward the first time it is won.
# The separate EU-branded machines open the Euromon archives via their PC tile behavior.

script studio_ordi
  ask - "Your computer. 437 unread emails blink in the corner of the screen."
  choice "Mailbox" "Shut Down" -> TMP
  if var TMP == 1 goto fin
  close
  minigame courriels
  if var RESULT == 0 goto rate
  if flag PC_MAIL_DONE goto deja
  setflag PC_MAIL_DONE
  say - "A notification pops up: “Congratulations on your productivity!” A parcel was waiting under the desk."
  giveitem x_reactivite 2
  goto fin
:deja
  say - "Empty inbox. Three seconds later: “Re: Coordination Meeting About Meetings”."
  goto fin
:rate
  say - "The mail server shows a loading icon. It'll probably still be showing it tomorrow."
  goto fin
:fin
end

script parl_ordi
  ask - "A press office computer. The screen reads: “Fact Check Unit – rumours to verify: 2,384”."
  choice "Fact Check" "Shut Down" -> TMP
  if var TMP == 1 goto fin
  close
  minigame desinfox
  if var RESULT == 0 goto rate
  if flag PC_INTOX_DONE goto deja
  setflag PC_INTOX_DONE
  say "Parliament officer" "Great fact-checking work! The press office gives you these expert reports. Sourced, for once."
  giveitem x_expertise 2
  goto fin
:deja
  say - "All today's rumours are checked. More will arrive by lunchtime."
  goto fin
:rate
  say - "A piece of fake news was just shared 40,000 times. The correction, 12 times."
  goto fin
:fin
end

script cjue_ordi
  say - "The DG Translation terminal. A red light is blinking: “Messages awaiting routing”."
  ask "Registrar" "The interpreters are swamped! Can you sort the messages and send them to the right booth?"
  yesno -> TMP
  if var TMP == 0 goto fin
  close
  minigame langues
  if var RESULT == 0 goto rate
  if flag PC_LANG_DONE goto deja
  setflag PC_LANG_DONE
  say "Registrar" "Twenty-four languages, no routing errors! Take this address book, every interpreter at the Court is in it."
  giveitem x_diplomatie 2
  goto fin
:deja
  say "Registrar" "You can tell Slovenian from Slovak better than half the Council."
  goto fin
:rate
  say "Registrar" "A Maltese message arrived in the Irish booth. They're still discussing it. Try again whenever you like."
  goto fin
:fin
end

script bce_ordi
  say - "A Bloomberg terminal, still warm. On a sticky note: “Target: 2%. Not 1.9. Not 2.1. 2.”"
  ask - "Take charge of the eurozone's monetary policy?"
  yesno -> TMP
  if var TMP == 0 goto fin
  close
  minigame taux
  if var RESULT == 0 goto rate
  if flag PC_TAUX_DONE goto deja
  setflag PC_TAUX_DONE
  say - "The markets applaud your caution. A stability bonus lands in your account!"
  money 3000
  goto fin
:deja
  say - "Inflation at 2%. Somewhere in Frankfurt, an economist sheds a tear of joy."
  goto fin
:rate
  say - "The terminal shows a rollercoaster-shaped graph. Nobody saw anything. Start again quickly."
  goto fin
:fin
end

script stras_ordi
  say - "The MEP's computer. On the desk, a tangle of 14 different chargers."
  ask "MEP" "I voted for the USB-C directive! But my colleagues still have old devices… Can you help me bring them up to code?"
  yesno -> TMP
  if var TMP == 0 goto fin
  close
  minigame usbc
  if var RESULT == 0 goto rate
  if flag PC_USBC_DONE goto deja
  setflag PC_USBC_DONE
  say "MEP" "One charger for everyone! Here, take this USB-C stick. Apparently it evolves certain digital Euromon."
  giveitem cle_usb 1
  goto fin
:deja
  say "MEP" "The cable drawer is finally empty. I don't know what to put in it anymore."
  goto fin
:rate
  say "MEP" "There are still Lightning cables everywhere… Try again whenever you like."
  goto fin
:fin
end
