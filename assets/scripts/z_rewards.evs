# Append new reward flags after the released scripts to preserve save IDs.
script stamp_repeat_reward
  if flag STAMP_SECOND_DONE goto hasard
  setflag STAMP_SECOND_DONE
  say "Registrar" "Another fifteen rulings in order! For your second success, here is a qualified stamp."
  giveitem tampon_qualifie 1
  goto fin
:hasard
  random 2 -> TMP
  if var TMP == 0 goto aucun
  say "Registrar" "Flawless! I have one qualified stamp left for you. Luxembourg loves methodical people."
  giveitem tampon_qualifie 1
  goto fin
:aucun
  say "Registrar" "Flawless! But I have no stamp for you this time. Come back and give me a hand again!"
:fin
end
